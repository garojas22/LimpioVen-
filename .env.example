# Variables de entorno para LimpioVen
# Copiar como .env y rellenar los valores localmente.
# En Cloudflare Pages: Settings → Environment variables.

# WhatsApp — solo dígitos con código de país (ej. 58424XXXXXXX)
VITE_WHATSAPP_NUMBER=

# Correo electrónico de contacto
VITE_EMAIL=

# Web3Forms — clave del formulario (web3forms.com → Access Key)
VITE_WEB3FORMS_KEY=

# Cloudflare Web Analytics — token del beacon (dash.cloudflare.com → Analytics → Web Analytics)
# Es un valor público: se incluye en el HTML generado. Déjalo vacío para desactivar el tracking.
VITE_CF_BEACON_TOKEN=
